# 复制本文件为 config/generated/local/defaults.env 后填写本机凭据。
# defaults.env 只在尚未生成 config/generated/local/.env 时读取，并已被 Git 忽略。

# 平台与端口
LOCAL_BACKEND_HOST=127.0.0.1
LOCAL_BACKEND_PORT=8000
LOCAL_FRONTEND_HOST=127.0.0.1
LOCAL_FRONTEND_PORT=5173

# PostgreSQL
LOCAL_POSTGRES_HOST=127.0.0.1
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DATABASE=openontology
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=

# Redis 与 Celery
LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_DATABASE=0
LOCAL_REDIS_USER=
LOCAL_REDIS_PASSWORD=

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=
MINIO_USE_SSL=false

# Chromium CDP
STEWARD_BROWSER_CDP_URL=http://127.0.0.1:9222

# n8n
N8N_API_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=30
