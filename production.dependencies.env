# OntologyBuild production third-party dependencies.
# This file is authoritative during nano-ontoprompt deployment. The deploy
# script merges these values into the server-side .env without replacing
# application-owned secrets such as SECRET_KEY or API_HUB_SYSTEM_MCP_TOKEN.

ENVIRONMENT=production
STRICT_PRODUCTION_CONFIG=true
REQUIRE_EXTERNAL_DEPENDENCIES=true

# PostgreSQL (the provider database name was not supplied, so use PostgreSQL's
# always-present maintenance database until a dedicated database is provisioned).
POSTGRES_HOST=38.76.215.169
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=user_cr4ktG
POSTGRES_PASSWORD=password_5GSsh7
DATABASE_URL=postgresql://user_cr4ktG:password_5GSsh7@38.76.215.169:5432/postgres

# Redis single-password mode.
REDIS_URL=redis://:redis_ACYhw8@38.76.215.169:6379/0
DATASET_IMPORT_USE_CELERY=true

# Neo4j.
NEO4J_URI=bolt://38.76.215.169:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=carle_Neo4j_2025
NEO4J_AUTH=neo4j/carle_Neo4j_2025

# The supplied :9001 URL is the MinIO browser console. MinIO SDK/S3 traffic
# uses the API endpoint on :9000; deployment probes this endpoint before start.
MINIO_CONSOLE_URL=http://38.76.215.169:9001
MINIO_ENDPOINT=38.76.215.169:9000
MINIO_ACCESS_KEY=carle
MINIO_SECRET_KEY=carle123
MINIO_USE_SSL=false

# A production dependency outage must fail readiness/deployment instead of
# silently writing new objects to the local filesystem.
STORAGE_LOCAL_FALLBACK=false
