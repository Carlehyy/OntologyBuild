[project]
requires = ["nodejs-24", "python-3.12"]

[dev]
build = ["sh", "-c", "cd frontend && npm ci && cd ../backend && pip3 install -r requirements.txt"]
run = ["bash", "-c", "cd backend && nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 > /app/work/logs/bypass/${COZE_WORKSPACE_PATH}/backend.log 2>&1 & sleep 2 && cd frontend && npm run dev"]

[deploy]
build = ["sh", "-c", "cd frontend && npm ci && npm run build && cd ../backend && pip3 install -r requirements.txt"]
run = ["bash", "-c", "cd backend && nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 > /app/work/logs/bypass/${COZE_WORKSPACE_PATH}/backend.log 2>&1 & sleep 2 && cd frontend && npm run preview"]
