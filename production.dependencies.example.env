# OntologyBuild production dependency manifest template.
#
# This is the no-secret template for manual checks and a future migration to
# individually scoped GitHub Environment Variables and Secrets. The current
# automatic deployment keeps using the repository-owner-approved tracked
# production.dependencies.env for compatibility.

ENVIRONMENT=production
PUBLIC_PORT=8088
STRICT_PRODUCTION_CONFIG=true
REQUIRE_EXTERNAL_DEPENDENCIES=true

# PostgreSQL
POSTGRES_HOST=postgres.example.com
POSTGRES_PORT=5432
POSTGRES_DB=ontologybuild
POSTGRES_USER=ontologybuild
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis must use authenticated single-password mode.
REDIS_URL=
DATASET_IMPORT_USE_CELERY=true

# Neo4j
NEO4J_URI=bolt+s://neo4j.example.com:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_AUTH=

# MinIO / S3-compatible object storage. MINIO_ENDPOINT is host:API-port only.
MINIO_CONSOLE_URL=https://minio-console.example.com
MINIO_ENDPOINT=minio.example.com:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
STORAGE_LOCAL_FALLBACK=false

# Externally managed n8n.
N8N_API_URL=https://n8n.example.com/api/v1
N8N_EMAIL=
N8N_PASSWORD=
N8N_API_KEY=
