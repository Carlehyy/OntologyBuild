# 服务器首次部署会自动生成并持久化运行密钥；GitHub 只需三项 SSH Secret。
# 旧环境先兼容告警，完成密钥轮换后可开启严格阻断。
ENVIRONMENT=development
DATABASE_URL=postgresql://ontoprompt:ontoprompt@db:5432/ontoprompt
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=
# Existing installations should leave ENCRYPTION_KEY empty until an explicit
# credential re-encryption migration is performed; empty derives it from SECRET_KEY.
# Do not rotate SECRET_KEY in that mode without migrating stored ciphertext first.
# Empty CORS means same-origin only. Use comma-separated exact origins if needed.
CORS_ALLOWED_ORIGINS=
FIRST_ADMIN_USER=admin
FIRST_ADMIN_PASSWORD=admin123
UPLOADS_DIR=/uploads
# 超级助手 Skill 默认保存到 <UPLOADS_DIR>/super-assistant/skills/<user>/<skill-id>。
SUPER_ASSISTANT_SKILL_ROOT=
# 公网 MCP 无需白名单；生产环境会自动拒绝环回、内网和链路本地地址。
# stdio 会在后端容器内启动进程，默认关闭；启用后仍需显式列出可执行 command。
SUPER_ASSISTANT_MCP_STDIO_ENABLED=false
SUPER_ASSISTANT_MCP_STDIO_ALLOWED_COMMANDS=
# 数据管家：会话文件根目录与独立浏览器 CDP 地址。生产 compose 默认覆盖为容器服务名。
STEWARD_WORKSPACE_ROOT=
STEWARD_BROWSER_CDP_URL=http://browser:9222
STEWARD_BROWSER_TIMEOUT_SECONDS=30
STEWARD_BROWSER_MAX_CAPTURES=300
STEWARD_BROWSER_FRAME_INTERVAL_MS=250
# WebSocket 被终端或代理拦截时，实时画面自动改走 HTTPS 轮询。
STEWARD_BROWSER_HTTP_LEASE_SECONDS=30
STEWARD_BROWSER_HTTP_FRAME_INTERVAL_MS=500
STEWARD_BROWSER_MAX_SESSIONS=8
STEWARD_BROWSER_MAX_SESSIONS_PER_USER=3
STEWARD_BROWSER_IDLE_TIMEOUT_SECONDS=900
STEWARD_BROWSER_REAPER_INTERVAL_SECONDS=30
STEWARD_BROWSER_ALLOW_PRIVATE_NETWORKS=true
STEWARD_PROXY_BASE_URL=http://backend:8000/api-hub/proxy
# n8n 必须能访问此地址。生产部署脚本会在该值仍为默认值时，根据 HEALTH_URL
# 自动改成平台公网地址；显式配置的 HTTPS 地址永远不会被覆盖。
PIPELINE_FILE_GATEWAY_BASE_URL=http://backend:8000/api/v2/file-transfer
# 浏览器公网入口与 n8n 网关相互独立：APP 用于生成登录后继续下载的 Hash 深链，
# API 用于生成无需登录的匿名下载接口。两者都必须能从其他电脑的浏览器访问，
# 且只填写 HTTP(S) origin（不要包含路径、账号、查询参数或 # 片段）。
PIPELINE_FILE_PUBLIC_APP_BASE_URL=http://localhost:5173
PIPELINE_FILE_PUBLIC_API_BASE_URL=http://localhost:8000
# 可选：容器内 OfficeCLI 可执行文件的绝对路径。留空时核心会话文件空间仍可用，
# 但探索 Agent 不会获得 docx/xlsx/pptx 的结构化编辑工具。
EXPLORATION_OFFICECLI_PATH=
# MinIO is preferred when reachable. The fallback URI records ``local://`` so
# objects remain readable after MinIO recovers. This relative default is for
# source development; docker-compose.prod.yml defaults to the shared persistent
# volume /uploads/object-storage, and strict production rejects relative paths.
STORAGE_LOCAL_FALLBACK=true
STORAGE_LOCAL_DIR=storage
# Set both values below only when Redis/Celery and every external dependency
# are intentionally mandatory. Production then fails closed instead of using
# synchronous dataset imports or local object storage.
DATASET_IMPORT_USE_CELERY=false
REQUIRE_EXTERNAL_DEPENDENCIES=false
ALLOW_PUBLIC_REGISTRATION=true
PIPELINE_MAX_IN_MEMORY_ROWS=500000

# Production deploys require immutable @sha256 image references for every
# entry below. Floating tags are shown only as local/CI defaults.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NEO4J_IMAGE=neo4j:5-community
MINIO_IMAGE=minio/minio:latest
CHROMA_IMAGE=chromadb/chroma:0.5.20
BROWSER_IMAGE=chromedp/headless-shell:latest
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
# Set to 1 only after all image variables above use immutable @sha256 references.
STRICT_IMAGE_DIGESTS=0
STRICT_PRODUCTION_CONFIG=false

# LiteLLM Proxy — 填入需要的 provider key，不用的留空即可
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
# LiteLLM Admin UI (passed via docker-compose environment, not DATABASE_URL)
LITELLM_MASTER_KEY=sk-master-change-me
LITELLM_SALT_KEY=sk-salt-change-me
UI_USERNAME=admin
UI_PASSWORD=change-me-litemll-admin-password
# Note: LiteLLM uses its own DB (litellm) — see docker-compose.yml litellm service

# API Hub / 接口代理（W3 登录可选；已登记接口可调用任意 HTTP/HTTPS 目标）
W3_USERNAME=
W3_PASSWORD=
W3_LOGIN_URL=https://login.huawei.com/login1/rest/hwidcenter/login
# 只允许向这些域名提交 W3 账号密码；修改账号或登录地址时必须同时重新输入密码。
API_HUB_W3_LOGIN_ALLOWED_HOSTS=login.huawei.com
API_HUB_DATA_DIR=
API_HUB_DEFAULT_CRON=0 */2 * * *
API_HUB_HTTP_TIMEOUT=30
API_HUB_MAX_RUNS_PER_INTERFACE=20
# 接口重定向次数上限；每次重定向仍会校验目标必须是合法的 HTTP/HTTPS URL。
API_HUB_OUTBOUND_MAX_REDIRECTS=5
# 私有 CA 场景填写 CA bundle 路径；留空仍会校验系统信任链，不能关闭 TLS 校验。
API_HUB_TLS_CA_BUNDLE=
# 令牌留空时对应 MCP 入口保持禁用（503），令牌只保存在服务端与调用方凭据库中。
API_HUB_MCP_TOKEN=
API_HUB_SYSTEM_MCP_TOKEN=
API_HUB_MCP_SERVER_NAME=api-hub
API_HUB_MCP_MAX_BODY_CHARS=20000
# 生产域名示例：api.example.com、https://api.example.com
API_HUB_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
API_HUB_MCP_ALLOWED_ORIGINS=http://localhost:*,https://localhost:*,http://127.0.0.1:*,https://127.0.0.1:*
# 普通 HTTP 发布入口与调用方鉴权。公开接口形如 /proxy/<公开路径>，
# 调用方在 X-API-Hub-Key 中传入平台创建的独立密钥。
API_HUB_PROXY_PATH=/proxy
API_HUB_PROXY_KEY_HEADER=X-API-Hub-Key
API_HUB_PROXY_MAX_REQUEST_BYTES=10485760

# v2 — Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontoprompt123

# v2 — MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# v2 — ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8001
